{
  "name": "simplur",
  "type": "module",
  "version": "4.1.1",
  "description": "Simple, versatile string pluralization",
  "main": "./dist/simplur.js",
  "exports": {
    ".": "./dist/simplur.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "pretest": "npm run build",
    "test": "node --test dist/**/*.test.js",
    "test:watch": "node --test --watch src/**/*.test.ts "
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/broofa/simplur.git"
  },
  "files": [
    "dist/**",
    "!dist/**/*.test.*"
  ],
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "keywords": [
    "pluralize",
    "pluralise",
    "plural",
    "plur",
    "inflection",
    "inflector"
  ],
  "author": {
    "name": "Robert Kieffer",
    "url": "http://github.com/broofa",
    "email": "robert@broofa.com"
  },
  "license": "ISC",
  "packageManager": "npm@10.5.2+sha256.df0a1f7691654b94786013e5d5b80a873a7ffbae9c82c3bec8b5db76bc3b7dfd",
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "@commitlint/config-conventional": "20.5.3",
    "@types/node": "25.2.3",
    "lefthook": "2.1.6",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "commitlint": "20.5.3"
  }
}
