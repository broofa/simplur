{
  "name": "simplur",
  "type": "module",
  "version": "4.1.1",
  "description": "Simple, versatile string pluralization",
  "main": "./dist/simplur.js",
  "exports": {
    ".": "./dist/simplur.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "docs": "runmd --check README_js.md -o README.md",
    "docs:fix": "runmd README_js.md -o README.md",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "pretest": "npm run build",
    "test": "node --test dist/**/*.test.js",
    "test:watch": "node --test --watch src/**/*.test.ts "
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/broofa/simplur.git"
  },
  "files": [
    "dist/**",
    "!dist/**/*.test.*"
  ],
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "keywords": [
    "pluralize",
    "pluralise",
    "plural",
    "plur",
    "inflection",
    "inflector"
  ],
  "author": {
    "name": "Robert Kieffer",
    "url": "http://github.com/broofa",
    "email": "robert@broofa.com"
  },
  "license": "ISC",
  "packageManager": "npm@12.2.0",
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/config-conventional": "21.2.3",
    "@types/node": "26.6.5",
    "commitlint": "21.2.3",
    "lefthook": "2.2.2",
    "runmd": "2.1.1",
    "typescript": "7.0.2"
  }
}
